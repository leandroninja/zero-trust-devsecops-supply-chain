*.auto.tfvars
override.tf
override.tf.json
*_override.tf
*_override.tf.json
.terraformrc
terraform.rc
# Planos de Terraform nunca devem ser commitados — podem ter dados sensíveis
*.tfplan
*.plan

# ─── Segurança — NUNCA commitar ───────────────────────────────────────────────
.env
.env.*
.env.local
.env.production
*.key
*.pem
*.crt
*.cer
*.pfx
*.p12
*.jks
*.keystore
secrets/
secret/
credentials/
credentials.json
service-account.json
*-sa.json
*-credentials.json
.aws/credentials
.azure/credentials
kubeconfig
*.kubeconfig
kube-config.yaml

# Chaves privadas e tokens
id_rsa
id_ed25519
*.priv
*.private
cosign.key            # chave privada do Cosign — usar keyless em produção
signing.key

# ─── SBOM output — gerado localmente, não deve ir para o repo ─────────────────
sbom-output/
# (os SBOMs de release vão como GitHub Release assets, não no repo)

# ─── Relatórios de scan ───────────────────────────────────────────────────────
# Gerados pela pipeline — artifacts do GitHub Actions, não do repo
trivy-results.*
semgrep.*
gitleaks-report.*
hadolint-results.*
checkov-*.sarif
zap-report.*
licenses-*.json
vulnerabilities.json
sbom-checksums.sha256

